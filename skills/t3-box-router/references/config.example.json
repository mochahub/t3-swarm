{
  "version": 1,
  "scriptPath": "/Users/you/.claude/skills/t3-box-router/scripts/box-router.mjs",
  "defaults": {
    "minLinkHours": 24,
    "linkTtlMinutes": 15,
    "factTtlHours": 24,
    "slotTtlMinutes": 180,
    "leaseTtlHours": 24,
    "cooldownMinutes": 30,
    "bringUpTimeoutMs": 120000,
    "bringUpRetryMinutes": 10,
    "probeTtlDays": 7
  },
  "local": {
    "tags": ["macos", "arm64", "ios-sim", "xcode"],
    "deviceHostId": "local",
    "priority": 0,
    "maxConcurrent": 4,
    "exclusive": ["ios-sim"]
  },
  "machines": {
    "home-box": {
      "kind": "always-on",
      "environmentId": "env-home-box",
      "url": "https://home-box.example",
      "tags": ["linux", "gpu", "ram-32g", "godot", "secret:build-signing"],
      "priority": 10,
      "maxConcurrent": 6,
      "exclusive": ["gpu"],
      "worktreeRoot": "~/work",
      "bringUp": ["/Users/you/bin/start-home-box", "home-box"],
      "bringUpTimeoutMs": 300000
    },
    "cloud-gpu": {
      "kind": "on-demand",
      "environmentId": "env-cloud-gpu",
      "tags": ["linux", "gpu"],
      "extraTags": ["ci"],
      "denyTags": ["display"],
      "priority": 5,
      "maxConcurrent": 2,
      "exclusive": ["gpu"],
      "worktreeRoot": "~/work",
      "bringUp": ["/Users/you/bin/start-cloud-gpu", "cloud-gpu"],
      "tearDown": ["/Users/you/bin/stop-cloud-gpu", "cloud-gpu"],
      "keepAlive": ["/Users/you/bin/ping-cloud-gpu", "cloud-gpu"],
      "hookTimeoutMs": 120000
    }
  },
  "repos": {
    "github.com/owner/repo": {
      "needs": ["godot"],
      "prefers": ["ram-32g"],
      "deny": [],
      "pin": "home-box",
      "worktreeCommand": "./scripts/worktree"
    }
  }
}
